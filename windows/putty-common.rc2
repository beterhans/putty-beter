/*
 * Windows resources shared between PuTTY and PuTTYtel, to be #include'd
 * after defining appropriate macros.
 *
 * Note that many of these strings mention PuTTY. Due to restrictions in
 * VC's handling of string concatenation, this can't easily be fixed.
 * It's fixed up at runtime.
 *
 * This file has the more or less arbitrary extension '.rc2' to avoid
 * IDEs taking it to be a top-level resource script in its own right
 * (which has been known to happen if the extension was '.rc'), and
 * also to avoid the resource compiler ignoring everything included
 * from it (which happens if the extension is '.h').
 */

/* Accelerators used: clw */
IDD_ABOUTBOX DIALOG DISCARDABLE 140, 40, 270, 136
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About PuTTY"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON "&Close", IDOK, 216, 118, 48, 14
    PUSHBUTTON "View &Licence", IDA_LICENCE, 6, 118, 70, 14
    PUSHBUTTON "Visit &Web Site", IDA_WEB, 140, 118, 70, 14
    EDITTEXT IDA_TEXT, 10, 6, 250, 110, ES_READONLY | ES_MULTILINE | ES_CENTER, WS_EX_STATICEDGE
END

/* Accelerators used: aco */
/*
 * PuTTY-beter: the configuration box is resizable (WS_THICKFRAME), and the
 * size given here is only the starting point. windows/dialog.c measures the
 * panel on display and grows the window if it needs to, so that the row of
 * buttons along the bottom can never be covered by panel controls running off
 * the end of their column.
 */
IDD_MAINBOX DIALOG DISCARDABLE 0, 0, 300, 300
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "PuTTY Configuration"
FONT 8, "MS Shell Dlg"
CLASS "PuTTYConfigBox"
BEGIN
END

/* Accelerators used: co */
IDD_LOGBOX DIALOG DISCARDABLE 100, 20, 300, 119
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PuTTY Event Log"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON "&Close", IDOK, 135, 102, 44, 14
    PUSHBUTTON "C&opy", IDN_COPY, 81, 102, 44, 14
    LISTBOX IDN_LIST, 3, 3, 294, 95, LBS_HASSTRINGS | LBS_USETABSTOPS | WS_VSCROLL | WS_HSCROLL | LBS_EXTENDEDSEL
END

/* No accelerators used */
IDD_LICENCEBOX DIALOG DISCARDABLE 50, 50, 326, 239
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PuTTY Licence"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON "OK", IDOK, 148, 219, 44, 14

    EDITTEXT IDA_TEXT, 10, 10, 306, 200, ES_READONLY | ES_MULTILINE | ES_LEFT, WS_EX_STATICEDGE
END

/* Accelerators used: achio */
IDD_HOSTKEY DIALOG DISCARDABLE 50, 50, 340, 240
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PuTTY Security Alert"
FONT 8, "MS Shell Dlg"
CLASS "PuTTYHostKeyDialog"
BEGIN
    ICON "", IDC_HK_ICON, 10, 18, 0, 0

    PUSHBUTTON "&Cancel", IDCANCEL, 288, 220, 40, 14
    PUSHBUTTON "&Accept", IDC_HK_ACCEPT, 168, 220, 40, 14
    PUSHBUTTON "Connect &Once", IDC_HK_ONCE, 216, 220, 64, 14
    PUSHBUTTON "More &info...", IDC_HK_MOREINFO, 60, 220, 64, 14
    PUSHBUTTON "&Help", IDHELP, 12, 220, 40, 14

    LTEXT "", IDC_HK_TITLE, 40, 20, 300, 12

    EDITTEXT IDC_HK_TEXT, 40, 20, 290, 200, ES_READONLY | ES_MULTILINE | ES_LEFT, WS_EX_STATICEDGE
END

/* Accelerators used: c */
IDD_HK_MOREINFO DIALOG DISCARDABLE 140, 40, 400, 300
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PuTTY: information about the server's host key"
FONT 8, "MS Shell Dlg"
CLASS "PuTTYHostKeyMoreInfo"
BEGIN
    DEFPUSHBUTTON "&Close", IDOK, 176, 130, 48, 14
END

/* Accelerators used: aco */
IDD_CA_CONFIG DIALOG DISCARDABLE 0, 0, 350, 260
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PuTTY trusted host certification authorities"
FONT 8, "MS Shell Dlg"
CLASS "PuTTYConfigBox"
BEGIN
END

/*
 * PuTTY-beter: choose where the configuration folder lives.
 *
 * Shown on first run (when there is no configuration yet), or when Alt is held
 * at launch, or when PUTTY_CONFIG_RELOCATE=1 - the same three triggers as the
 * macOS front end, and the same key: Option on a Mac is Alt on a PC.
 */
/* Accelerators used: ksu */
IDD_CONFIG_LOCATION DIALOG DISCARDABLE 0, 0, 300, 136
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PuTTY configuration folder"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_CL_MSG, 10, 8, 280, 56
    EDITTEXT IDC_CL_PATH, 10, 68, 232, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Choose...", IDC_CL_BROWSE, 248, 68, 42, 14
    LTEXT "", IDC_CL_HINT, 10, 88, 280, 22
    DEFPUSHBUTTON "Use This Folder", IDOK, 160, 116, 76, 14
    PUSHBUTTON "Keep Current", IDCANCEL, 240, 116, 50, 14
END

/*
 * PuTTY-beter: the ZMODEM transfer progress window (tech_detail.md section 12).
 * A modeless dialog, created with CreateDialog rather than DialogBox, because
 * the engine is driven from the main loop and a modal dialog would block the
 * transfer it is reporting on. On the macOS side the equivalent is built in
 * code; here it is a template, which is how every other Windows dialog is done.
 */
/* Accelerators used: c */
IDD_ZMODEM DIALOG DISCARDABLE 0, 0, 260, 76
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ZMODEM transfer"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Starting...", IDC_ZM_STATUS, 12, 10, 236, 18
    CONTROL "", IDC_ZM_PROGRESS, "msctls_progress32",
            WS_CHILD | WS_VISIBLE | PBS_SMOOTH, 12, 32, 236, 14
    PUSHBUTTON "&Cancel", IDC_ZM_CANCEL, 200, 54, 48, 14
END

#include "version.rc2"
