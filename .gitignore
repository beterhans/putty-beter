# --- local build/bundle output and safety backups (putty-beter) ---
# CMake build trees (binaries + the .app bundle stage)
/build-*/
/build/
# Windows build/bundle output (putty.exe + a staged putty-mcp/ with
# node_modules), written by scripts/build-windows.ps1.
/putty-beter-win64/
# Safety copies made before editing upstream source files
*.old

# Local bug-report screenshots
/issue/

# Agent working notes (kept local; may contain machine-specific paths)
/_agent/

# gtk-mac-bundler checkout (GPL-2.0 third-party build tool; fetch it yourself - see tools/README.md)
/tools/gtk-mac-bundler/

# macOS Finder metadata
.DS_Store

# The MCP bridge's dependencies. Recreate them with `cd mcp && npm install`;
# package-lock.json is committed, so the SDK version is pinned.
/mcp/node_modules/
