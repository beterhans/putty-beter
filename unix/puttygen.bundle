<?xml version="1.0" standalone="no"?> <!--*- mode: xml -*-->
<app-bundle>

  <!--
      PuTTY-beter: the gtk-mac-bundler description for PuTTYGen.app
      (PLAN.md section 4m). It is deliberately a near-copy of putty.bundle:
      the GTK tree it copies in is exactly the same, and only three things
      differ - the plist, the main binary (puttygenapp instead of puttyapp)
      and the icon.

      gtk-mac-bundler accepts exactly one bundle file per run
      (tools/gtk-mac-bundler/bundler/main.py: `if len(argv) != 1: exit(2)`),
      so scripts/bundle-macos.sh invokes it once per .app.

      The launcher needs no change: osxlaunch derives everything from its own
      path and execs "<own path>-bin", so the same osxlaunch binary serves
      both apps (Contents/MacOS/PuTTYGen execs Contents/MacOS/PuTTYGen-bin).
  -->

  <meta>
    <!-- See putty.bundle for the full explanation of this workaround: the
         prefix has to be passed in as an environment variable because
         ${pkg:...} is not expanded inside <prefix>. -->
    <prefix name="default">${env:PUTTY_GTK_PREFIX_FROM_MAKEFILE}</prefix>

    <run-install-name-tool/>
    <gtk>gtk+-3.0</gtk>
    <launcher-script>${project}/../osxlaunch</launcher-script >
  </meta>

  <plist>${project}/puttygen.plist</plist>

  <main-binary dest="${bundle}/Contents/MacOS">
    ${project}/../puttygenapp
  </main-binary>

  <binary>
    ${prefix}/lib/${gtkdir}/${pkg:${gtk}:gtk_binary_version}/immodules/*.so
  </binary>

  <binary>
    ${prefix}/lib/${gtkdir}/${pkg:${gtk}:gtk_binary_version}/printbackends/*.so
  </binary>

  <binary>
    ${prefix}/lib/gdk-pixbuf-2.0/${pkg:gdk-pixbuf-2.0:gdk_pixbuf_binary_version}/loaders/*.so
  </binary>

  <data dest="${bundle}/Contents/Resources">
    ${project}/../icons/PuTTYgen.icns
  </data>

  <icon-theme icons="auto">
    Adwaita
  </icon-theme>

</app-bundle>
